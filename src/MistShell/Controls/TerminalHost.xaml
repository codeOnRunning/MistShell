<UserControl x:Class="MistShell.Controls.TerminalHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource TerminalBackgroundBrush}">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <Border x:Name="LoadingOverlay" Background="{DynamicResource TerminalBackgroundBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="正在准备终端引擎…" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
