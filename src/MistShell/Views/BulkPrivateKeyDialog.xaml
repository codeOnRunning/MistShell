<Window x:Class="MistShell.Views.BulkPrivateKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量设置私钥" Width="520" Height="430" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0,5,0">
                    <TextBlock Text="批量设置私钥" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Width="38" Height="42" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,18,22,10">
                <TextBlock x:Name="IntroText" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="选择已保存私钥" Style="{StaticResource FieldLabel}" Margin="2,17,0,6" />
                <ListBox x:Name="KeyList" Height="98" DisplayMemberPath="Name" />
                <Button Content="管理私钥…" Style="{StaticResource GhostButton}" Padding="8,3" Height="27"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="ManageKeys_Click" />
                <TextBlock Text="私钥口令（没有则留空）" Style="{StaticResource FieldLabel}" Margin="2,15,0,6" />
                <PasswordBox x:Name="PassphraseBox" MinHeight="32" />
                <TextBlock Text="留空会清除这些连接原有的私钥口令。" FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="2,5,0,0" />
                <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="7" Padding="10,7" Margin="0,12,0,0"
                        Visibility="Collapsed" x:Name="ErrorPanel">
                    <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Content="取消" Style="{StaticResource BaseButton}" MinWidth="78" Height="32" Click="Cancel_Click" />
                    <Button Content="应用到连接" Style="{StaticResource PrimaryButton}" MinWidth="104" Height="32"
                            Margin="9,0,0,0" IsDefault="True" Click="Apply_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
