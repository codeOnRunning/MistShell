<Window x:Class="MistShell.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="590" Height="735" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0,5,0">
                    <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Width="38" Height="42" Click="Cancel_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,14">
                    <TextBlock Text="外观主题" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="所有主题都避开纯白和纯黑背景，降低长时间使用时的屏幕刺激。点击标题栏主题按钮可循环预览。"
                               Style="{StaticResource MutedText}" Margin="0,3,0,10" TextWrapping="Wrap" />
                    <WrapPanel x:Name="ThemePanel" />

                    <Border Style="{StaticResource CardBorder}" Padding="14,11" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="快速切换" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Text="标题栏右侧的主题按钮会按顺序循环切换所有主题；在设置里可以直接定位到喜欢的配色。"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="终端" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />

                    <TextBlock Text="终端字体" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <TextBlock Text="内置 JetBrains Mono 和 Cascadia Mono，不需要在系统里额外安装。"
                               Style="{StaticResource MutedText}" Margin="2,0,0,7" TextWrapping="Wrap" />
                    <WrapPanel x:Name="FontPanel" />

                    <Border Style="{StaticResource CardBorder}" Padding="11,7" Margin="0,8,0,0">
                        <TextBlock x:Name="FontPreviewText" Text="MistShell  AaBbCc 0123  ~/projects $"
                                   FontSize="14" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock Text="行高" Style="{StaticResource FieldLabel}" Margin="2,13,0,6" />
                    <WrapPanel>
                        <RadioButton x:Name="LineCompactRadio" Content="紧凑" Style="{StaticResource ChoiceRadio}"
                                     GroupName="LineHeight" Tag="1.1" MinWidth="72" Margin="0,0,7,0" />
                        <RadioButton x:Name="LineNormalRadio" Content="标准" Style="{StaticResource ChoiceRadio}"
                                     GroupName="LineHeight" Tag="1.25" MinWidth="72" Margin="0,0,7,0" />
                        <RadioButton x:Name="LineRelaxedRadio" Content="宽松" Style="{StaticResource ChoiceRadio}"
                                     GroupName="LineHeight" Tag="1.45" MinWidth="72" />
                    </WrapPanel>

                    <TextBlock Text="终端文字颜色" Style="{StaticResource FieldLabel}" Margin="2,15,0,6" />
                    <TextBlock Text="只影响没有 ANSI 颜色的普通文字；zsh 的彩色输出不会被覆盖。留空跟随主题。"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TerminalForegroundBox" MinHeight="32" Padding="9,6"
                                 TextChanged="TerminalForegroundBox_TextChanged" />
                        <Button Grid.Column="1" Content="跟随主题" Style="{StaticResource GhostButton}"
                                Height="32" Padding="8,3" Margin="7,0,0,0" Click="ClearForeground_Click" />
                    </Grid>

                    <CheckBox x:Name="FollowDirectoryCheck" Content="终端目录联动" FontWeight="SemiBold" Margin="0,15,0,0" />
                    <TextBlock Text="在终端执行 cd 后，右侧文件面板自动打开对应目录。"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="26,4,0,0" />

                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="字体大小" FontSize="12" />
                            <TextBlock Text="终端字符大小，调整后新会话立即生效；也可在终端内按 Ctrl + 鼠标滚轮调节。"
                                       Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FontMinusButton" Style="{StaticResource IconButton}" Content="&#xE738;" Width="28" Height="28"
                                    Click="FontMinus_Click" ToolTip="减小字号" />
                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Width="56" Height="28" Margin="5,0">
                                <TextBlock x:Name="FontSizeText" Text="14" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button x:Name="FontPlusButton" Style="{StaticResource IconButton}" Content="&#xE710;" Width="28" Height="28"
                                    Click="FontPlus_Click" ToolTip="增大字号" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="回滚行数" FontSize="12" />
                        <TextBlock Text="每个终端保留的历史行数，越大占用内存越多。" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <TextBox x:Name="ScrollbackBox" MinHeight="42" Height="42" Padding="9,6"
                                 Margin="0,7,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource CardBorder}" Padding="13,11" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox x:Name="LowMemoryCheck" Content="低内存模式" FontWeight="SemiBold" />
                            <TextBlock Text="限制终端历史缓冲为 2000 行，并把监控刷新间隔调整为 5 秒。适合同时打开多个会话。"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="26,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="快捷键" FontSize="11.5" FontWeight="SemiBold" />
                                <TextBlock Text="查看终端复制、粘贴和其他快捷键说明。" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="查看快捷键" Style="{StaticResource GhostButton}" Height="27"
                                    Padding="8,3" VerticalAlignment="Center" Click="Shortcuts_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="数据" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                    <Border Style="{StaticResource CardBorder}" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本地配置目录" FontSize="11.5" />
                                <TextBlock x:Name="DataPathText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开" Style="{StaticResource GhostButton}" Height="27" Padding="8,3"
                                    VerticalAlignment="Center" Click="OpenDataFolder_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Content="取消" Style="{StaticResource BaseButton}" MinWidth="78" Height="33" Click="Cancel_Click" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" MinWidth="104" Height="33"
                            Margin="9,0,0,0" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
