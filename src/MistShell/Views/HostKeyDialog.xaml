<Window x:Class="MistShell.Views.HostKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主机指纹" Width="540" Height="430" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0,5,0">
                    <TextBlock Text="验证服务器指纹" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Width="38" Height="42" Click="Reject_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,18,22,10">
                <Border x:Name="WarningPanel" Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="12,9"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="主机指纹已变化" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="这可能意味着服务器重装过，也可能存在中间人攻击。请先通过其他可信渠道核对指纹。"
                                   FontSize="10.5" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="IntroText" Text="首次连接这台服务器。请确认下面的 SHA256 指纹与服务器管理员提供的一致。"
                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,0,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="服务器" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="HostText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="密钥类型" Style="{StaticResource MutedText}" />
                    <TextBlock x:Name="KeyTypeText" Grid.Row="1" Grid.Column="1" FontSize="12" FontFamily="{DynamicResource MonoFont}" />
                    <TextBlock Grid.Row="2" Text="SHA256" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </Grid>
                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,8,0,0">
                    <TextBlock x:Name="FingerprintText" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                               TextWrapping="Wrap" LineHeight="18" />
                </Border>
                <TextBlock Text="确认后，该指纹会保存在本机。下次连接时指纹若发生变化，会再次警告。"
                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid Margin="18,0">
                    <Button Content="取消连接" Style="{StaticResource BaseButton}" MinWidth="86" Height="33"
                            HorizontalAlignment="Left" Click="Reject_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="仅本次信任" Style="{StaticResource BaseButton}" MinWidth="92" Height="33"
                                Click="TrustOnce_Click" />
                        <Button Content="信任并保存" Style="{StaticResource PrimaryButton}" MinWidth="104" Height="33"
                                Margin="9,0,0,0" IsDefault="True" Click="TrustSave_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
