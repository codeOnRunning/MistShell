<Window x:Class="MistShell.Views.PrivateKeyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 私钥管理" Width="720" Height="590" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0,5,0">
                    <TextBlock Text="SSH 私钥管理" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Width="38" Height="42" Click="Close_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="205" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="已保存私钥" FontSize="12" FontWeight="SemiBold" Margin="2,2,0,8" />
                        <ListBox x:Name="KeyList" Grid.Row="1" DisplayMemberPath="Name"
                                 SelectionChanged="KeyList_SelectionChanged" />
                        <Button Grid.Row="2" Content="新建私钥" Style="{StaticResource BaseButton}"
                                Height="30" Margin="0,8,0,0" Click="New_Click" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="私钥名称" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" MinHeight="32" Margin="0,5,0,0" />
                    <TextBlock Text="私钥内容" Style="{StaticResource FieldLabel}" Margin="2,13,0,6" />
                    <TextBox x:Name="KeyBox" Height="245" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Button Content="从文件导入" Style="{StaticResource BaseButton}" Padding="10,4" Height="29"
                                Click="Import_Click" />
                        <Button Content="从剪贴板粘贴" Style="{StaticResource BaseButton}" Padding="10,4" Height="29"
                                Margin="8,0,0,0" Click="Paste_Click" />
                        <Button Content="删除此私钥" Style="{StaticResource GhostButton}" Padding="10,4" Height="29"
                                Margin="8,0,0,0" Click="Delete_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="2,9,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="私钥内容使用 Windows DPAPI 加密保存，仅当前 Windows 用户可解密。"
                               Style="{StaticResource MutedText}" Margin="2,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Content="关闭" Style="{StaticResource BaseButton}" MinWidth="78" Height="32" Click="Close_Click" />
                    <Button Content="保存私钥" Style="{StaticResource PrimaryButton}" MinWidth="104" Height="32"
                            Margin="9,0,0,0" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
