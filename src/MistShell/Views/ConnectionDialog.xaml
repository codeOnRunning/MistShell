<Window x:Class="MistShell.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接" Width="570" Height="710" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="62" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0,5,0">
                    <TextBlock x:Name="TitleText" Text="新建连接" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Width="38" Height="42" Click="Cancel_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,17,22,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="连接名称" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" MinHeight="34" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="分组" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="GroupBox" MinHeight="34" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="主机地址" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="HostBox" MinHeight="34" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PortBox" MinHeight="34" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" Margin="2,13,0,6" />
                    <TextBox x:Name="UsernameBox" MinHeight="34" />

                    <TextBlock Text="认证方式" Style="{StaticResource FieldLabel}" Margin="2,15,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PasswordAuthRadio" Content="密码" Style="{StaticResource ChoiceRadio}"
                                     GroupName="Auth" IsChecked="True" MinWidth="90" Checked="Auth_Changed" />
                        <RadioButton x:Name="KeyAuthRadio" Content="私钥" Style="{StaticResource ChoiceRadio}"
                                     GroupName="Auth" MinWidth="90" Margin="7,0,0,0" Checked="Auth_Changed" />
                    </StackPanel>

                    <StackPanel x:Name="PasswordPanel" Margin="0,14,0,0">
                        <TextBlock Text="登录密码" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" MinHeight="34" />
                        <TextBlock x:Name="PasswordHint" Text="编辑连接时留空，表示保留已保存的密码。" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="2,5,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="KeyPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="私钥文件" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyPathBox" MinHeight="34" />
                            <Button Grid.Column="2" Content="浏览…" Style="{StaticResource BaseButton}" MinHeight="34"
                                    Click="BrowseKey_Click" />
                        </Grid>
                        <TextBlock Text="已保存私钥" Style="{StaticResource FieldLabel}" Margin="2,13,0,6" />
                        <WrapPanel x:Name="SavedKeyPanel" />
                        <Button Content="管理私钥…" Style="{StaticResource GhostButton}" Padding="8,3" Height="27"
                                HorizontalAlignment="Left" Margin="0,4,0,0" Click="ManageKeys_Click" />
                        <TextBlock Text="私钥口令（没有则留空）" Style="{StaticResource FieldLabel}" Margin="2,13,0,6" />
                        <PasswordBox x:Name="PassphraseBox" MinHeight="34" />
                        <TextBlock x:Name="PassphraseHint" Text="编辑连接时留空，表示保留已保存的私钥口令。" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="2,5,0,0" />
                    </StackPanel>

                    <TextBlock Text="备注" Style="{StaticResource FieldLabel}" Margin="2,14,0,6" />
                    <TextBox x:Name="NotesBox" MinHeight="62" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="7" Padding="10,7" Margin="0,13,0,0"
                            Visibility="Collapsed" x:Name="ErrorPanel">
                        <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="密码和私钥口令使用 Windows DPAPI 加密，仅当前 Windows 用户可解密。"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="2,14,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                    <Button Content="取消" Style="{StaticResource BaseButton}" MinWidth="78" Height="33" Click="Cancel_Click" />
                    <Button Content="保存连接" Style="{StaticResource PrimaryButton}" MinWidth="104" Height="33"
                            Margin="9,0,0,0" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
