<Window x:Class="MistShell.Views.RemoteFileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑远程文件" Width="900" Height="680" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,0,5,0">
                    <TextBlock x:Name="TitleText" Text="编辑远程文件" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,45,0" />
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                            Width="38" Height="42" Click="Close_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,12,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="远程路径" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="PathText" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                               Margin="2,3,0,8" />
                </StackPanel>
                <TextBox Grid.Row="1" x:Name="EditorBox" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}"
                         FontSize="12" Padding="10,7" TextChanged="EditorBox_TextChanged" />
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource SurfaceBrush}">
                <Grid Margin="18,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" MinWidth="88" Height="32"
                                Click="Save_Click" />
                        <Button Content="关闭" Style="{StaticResource BaseButton}" MinWidth="78" Height="32"
                                Margin="8,0,0,0" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
