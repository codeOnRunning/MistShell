<Window x:Class="MistShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MistShell.Controls"
        mc:Ignorable="d"
        Title="MistShell" Icon="Assets/app.ico"
        Width="1440" Height="900" MinWidth="1060" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="43" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="27" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="M" Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MistShell" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="轻量 SSH 工作台" FontSize="11.5" Margin="10,1,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <TextBlock Text="{Binding MemoryText}" Margin="0,0,13,0" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Content="&#xE706;" ToolTip="切换浅色 / 深色" Click="ThemeButton_Click"
                                AutomationProperties.Name="切换主题" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="设置" Click="SettingsButton_Click" Margin="2,0,0,0"
                                AutomationProperties.Name="设置" />
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource BorderBrush}" Margin="9,0,9,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="最小化" Click="Minimize_Click" AutomationProperties.Name="最小化" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="最大化" Click="Maximize_Click" AutomationProperties.Name="最大化" />
                        <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="关闭" Click="Close_Click" AutomationProperties.Name="关闭窗口" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="270" MinWidth="225" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="DockSplitterColumn" Width="5" />
                    <ColumnDefinition x:Name="DockColumn" Width="360" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="53" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="13,10,10,5">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="服务器" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ConnectionCountText}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="&#xE710;" HorizontalAlignment="Right"
                                    ToolTip="新建连接" Click="NewConnection_Click" />
                        </Grid>

                        <Border Grid.Row="1" Margin="12,2,12,8" Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="搜索服务器 / 主机 / 分组" Margin="31,0,8,0" VerticalAlignment="Center"
                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="11,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="29,4,8,4"
                                         MinHeight="30" FontSize="12" VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ListBox x:Name="ConnectionList" ItemsSource="{Binding ConnectionsView}"
                                     SelectedItem="{Binding SelectedConnection}"
                                     SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource ConnectionListItem}"
                                     MouseDoubleClick="ConnectionList_MouseDoubleClick"
                                     PreviewMouseRightButtonDown="ConnectionList_PreviewMouseRightButtonDown"
                                     KeyDown="ConnectionList_KeyDown"
                                     Margin="7,0,6,5">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="连接" Click="ContextConnect_Click" />
                                        <MenuItem Header="编辑连接" Click="ContextEdit_Click" />
                                        <MenuItem x:Name="BulkKeyMenuItem" Header="批量设置私钥…" Click="ContextBulkPrivateKey_Click" />
                                        <Separator />
                                        <MenuItem Header="复制一份" Click="ContextDuplicate_Click" />
                                        <MenuItem Header="删除连接" Click="ContextDelete_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <StackPanel>
                                                                <ToggleButton x:Name="HeaderToggle" IsChecked="True"
                                                                              HorizontalContentAlignment="Stretch"
                                                                              Background="Transparent" BorderThickness="0"
                                                                              Focusable="False">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                            <Border x:Name="HeaderBorder" Background="Transparent"
                                                                                    CornerRadius="6" Padding="9,7,4,4">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="16" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock x:Name="Chevron" Text="&#xE70D;"
                                                                                               FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                                               VerticalAlignment="Center" />
                                                                                    <TextBlock Grid.Column="1" Text="&#xE8B7;"
                                                                                               FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                                               Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                                    <ContentPresenter Grid.Column="2"
                                                                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                                                                      VerticalAlignment="Center" />
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="False">
                                                                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="HeaderBorder" Property="Background"
                                                                                            Value="{DynamicResource SurfaceHoverBrush}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                                        <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" FontSize="10.5"
                                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,0,0" />
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <Border x:Name="ItemsHost">
                                                                    <ItemsPresenter />
                                                                </Border>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger SourceName="HeaderToggle" Property="IsChecked" Value="False">
                                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="31" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="27" Height="27" CornerRadius="8" VerticalAlignment="Center"
                                                    Background="{Binding Color, Converter={StaticResource HexColorToBrush}}">
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="11.5"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Endpoint}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AuthLabel}" FontSize="9.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                           Margin="0,0,3,0" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE72A;" Width="22" Height="22"
                                                        FontSize="10" Tag="{Binding}" Click="ConnectConnection_Click"
                                                        ToolTip="连接"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=连接 {0}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnections}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="还没有服务器" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="新建连接，或从 FinalShell 导入" FontSize="11" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="10,6,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="+  新建连接" Style="{StaticResource PrimaryButton}" Click="NewConnection_Click" />
                            <Button Grid.Column="2" Content="导入" Style="{StaticResource GhostButton}" Click="ImportFinalShell_Click"
                                    ToolTip="从 FinalShell 的 conn 目录导入连接信息" />
                            <Button Grid.Column="4" Content="分享" Style="{StaticResource GhostButton}" Click="SharePackage_Click"
                                    ToolTip="生成不含服务器配置的安装包" />
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Workspace -->
                <Grid Grid.Column="2" Background="{DynamicResource WindowBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="39" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="45" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="SessionTabs" ItemsSource="{Binding Sessions}"
                                     SelectedItem="{Binding SelectedSession}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     BorderThickness="0" Background="Transparent" Margin="7,4,0,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,3,0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TabRoot" Height="31" CornerRadius="7,7,4,4" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                                Padding="9,0,3,0" MinWidth="145" MaxWidth="240">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" Margin="0,0,7,0"
                                                         Fill="{Binding Status, Converter={StaticResource SessionStatusToBrush}}" />
                                                <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}" FontSize="11.5"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource IconButton}"
                                                        Width="23" Height="23" FontSize="9" Tag="{Binding}" Click="CloseTab_Click"
                                                        ToolTip="关闭会话" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Column="1" Content="&#xE710;" Style="{StaticResource IconButton}" Margin="3,4,7,0"
                                    Width="28" Height="28" ToolTip="新建连接" Click="NewConnection_Click" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0,9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                         Fill="{Binding SelectedSession.Status, Converter={StaticResource SessionStatusToBrush}, TargetNullValue=#8A8F90}" />
                                <TextBlock Text="{Binding SelectedSessionTitle}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedSessionHost}" FontSize="11" Margin="9,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedSession.StatusDetail}" FontSize="10.5" Margin="14,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="文件" Style="{StaticResource GhostButton}" Padding="9,4" Height="27"
                                        Click="OpenFiles_Click" ToolTip="SFTP 文件管理" />
                                <Button Content="监控" Style="{StaticResource GhostButton}" Padding="9,4" Height="27"
                                        Click="OpenMonitor_Click" ToolTip="服务器监控" />
                                <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBrush}" Margin="5,0,5,0" />
                                <Button Content="美化" Style="{StaticResource GhostButton}" Padding="8,4" Height="27"
                                        Click="BeautifyShell_Click" ToolTip="发送彩色 ls / zsh 高亮配置（需要远端 shell 支持）" />
                                <Button Content="清屏" Style="{StaticResource GhostButton}" Padding="8,4" Height="27"
                                        Click="ClearTerminal_Click" ToolTip="清空当前终端显示" />
                                <Button Content="重连" Style="{StaticResource GhostButton}" Padding="8,4" Height="27"
                                        Click="Reconnect_Click" ToolTip="重新连接当前服务器" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Width="27" Height="27"
                                        Click="ToggleDock_Click" ToolTip="显示 / 隐藏右侧面板"
                                        AutomationProperties.Name="显示或隐藏右侧面板" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Background="{DynamicResource TerminalBackgroundBrush}">
                        <controls:TerminalHost x:Name="TerminalView"
                                               Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}" />
                        <Border Background="{DynamicResource WindowBackgroundBrush}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSessions}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="连接一台服务器开始工作" FontSize="19" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                                <TextBlock Text="SSH 终端、SFTP 文件管理和服务器监控，都在同一个轻量窗口里。"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button Content="新建连接" Style="{StaticResource PrimaryButton}" Padding="18,8"
                                            Click="NewConnection_Click" />
                                    <Button Content="导入 FinalShell" Style="{StaticResource BaseButton}" Padding="14,8"
                                            Margin="9,0,0,0" Click="ImportFinalShell_Click" />
                                </StackPanel>
                                <TextBlock Text="提示：双击左侧服务器即可打开终端" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                           Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid Margin="12,7,12,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="›" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="2,0,8,0" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="QuickCommandBox" Text="{Binding QuickCommand, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="30" Padding="9,4" IsEnabled="{Binding SelectedSession.IsConnected}"
                                         KeyDown="QuickCommand_KeyDown" VerticalContentAlignment="Center" />
                                <TextBlock Text="输入命令，Enter 发送到当前终端（↑ / ↓ 查看历史）"
                                           IsHitTestVisible="False" Margin="10,0,8,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=QuickCommandBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Content="发送" Style="{StaticResource PrimaryButton}" Padding="16,5"
                                    Margin="8,0,0,0" IsEnabled="{Binding SelectedSession.IsConnected}" Click="SendCommand_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="3" x:Name="DockSplitter" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="4" x:Name="DockPanel" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="8,5,7,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="文件" Style="{StaticResource DockTabRadio}" GroupName="DockTabs"
                                                 IsChecked="{Binding DockIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter=0, Mode=OneWay}"
                                                 Click="DockTab_Click" Tag="0" />
                                    <RadioButton Content="监控" Style="{StaticResource DockTabRadio}" GroupName="DockTabs"
                                                 IsChecked="{Binding DockIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter=1, Mode=OneWay}"
                                                 Click="DockTab_Click" Tag="1" Margin="2,0,0,0" />
                                    <RadioButton Content="命令" Style="{StaticResource DockTabRadio}" GroupName="DockTabs"
                                                 IsChecked="{Binding DockIndex, Converter={StaticResource EqualityToBoolean}, ConverterParameter=2, Mode=OneWay}"
                                                 Click="DockTab_Click" Tag="2" Margin="2,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                        Width="26" Height="26" ToolTip="收起面板" Click="ToggleDock_Click" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedSession}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="26" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="连接服务器后，这里会显示文件、监控和常用命令" TextWrapping="Wrap"
                                           TextAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,10,0,0" MaxWidth="230" />
                            </StackPanel>

                            <Grid Visibility="{Binding HasSelectedSession, Converter={StaticResource BoolToVisibility}}">
                            <!-- SFTP -->
                            <Grid Visibility="{Binding DockIndex, Converter={StaticResource EqualityToVisibility}, ConverterParameter=0}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="9,9,9,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74A;" Width="27" Height="27"
                                            ToolTip="上一级" Click="SftpUp_Click" />
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" Width="27" Height="27"
                                            ToolTip="刷新" Click="SftpRefresh_Click" Margin="2,0,0,0" />
                                    <TextBox Grid.Column="2" x:Name="SftpPathBox" Text="{Binding SelectedSession.Sftp.CurrentPath, Mode=OneWay}"
                                             MinHeight="27" Height="27" Padding="7,3" FontSize="11" Margin="5,0,0,0"
                                             KeyDown="SftpPath_KeyDown" />
                                    <Button Grid.Column="3" Content="前往" Style="{StaticResource GhostButton}" Padding="7,3"
                                            Height="27" Margin="4,0,0,0" Click="SftpGo_Click" />
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,2,10,6">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE898;" Width="27" Height="27"
                                            ToolTip="上传文件（可多选）" Click="SftpUpload_Click" AutomationProperties.Name="上传文件" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" Width="27" Height="27"
                                            ToolTip="上传文件夹（递归）" Click="SftpUploadFolder_Click"
                                            AutomationProperties.Name="上传文件夹" Margin="2,0,0,0" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE896;" Width="27" Height="27"
                                            ToolTip="下载所选文件（Ctrl / Shift 多选）" Click="SftpDownload_Click" Margin="2,0,0,0"
                                            AutomationProperties.Name="下载所选文件" />
                                    <Rectangle Width="1" Height="15" Fill="{DynamicResource BorderBrush}" Margin="6,0,6,0" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" Width="27" Height="27"
                                            ToolTip="新建文件夹" Click="SftpNewFolder_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Width="27" Height="27"
                                            ToolTip="重命名" Click="SftpRename_Click" Margin="2,0,0,0" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Width="27" Height="27"
                                            ToolTip="删除" Click="SftpDelete_Click" Margin="2,0,0,0" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72E;" Width="27" Height="27"
                                            ToolTip="修改权限" Click="SftpPermissions_Click" Margin="2,0,0,0" />
                                    <TextBlock Text="{Binding SelectedSession.Sftp.StatusText}" FontSize="10" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="8,0,8,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="7,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="大小" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="修改时间" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListBox Grid.Row="1" x:Name="SftpList" ItemsSource="{Binding SelectedSession.Sftp.Files}"
                                             SelectedItem="{Binding SelectedSession.Sftp.SelectedItem}"
                                             SelectionMode="Extended"
                                             MouseDoubleClick="SftpList_MouseDoubleClick"
                                             AllowDrop="True" Drop="SftpList_Drop" DragOver="SftpList_DragOver"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                            <Border x:Name="Root" CornerRadius="6" Background="Transparent" Padding="7,5"
                                                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding FullPath}" AutomationProperties.Name="{Binding Name}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="64" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="1" Text="{Binding SelectedSession.Sftp.ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                               FontSize="10.5" TextWrapping="Wrap" Margin="6,4" VerticalAlignment="Bottom"
                                               Visibility="{Binding SelectedSession.Sftp.HasError, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Visibility="{Binding SelectedSession.Sftp.Transfers.Count, Converter={StaticResource CountToVisibility}}">
                                    <Grid Margin="9,5,9,7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="传输队列" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Content="清除已完成" Style="{StaticResource GhostButton}" FontSize="9.5"
                                                    Padding="4,1" Height="20" HorizontalAlignment="Right" Click="ClearTransfers_Click" />
                                        </Grid>
                                        <ScrollViewer Grid.Row="1" MaxHeight="118" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedSession.Sftp.Transfers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3,0,2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="18" />
                                                                <RowDefinition Height="13" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,92,0" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding Status}" FontSize="9.5"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               ToolTip="{Binding Error}" />
                                                                    <Button Content="重试" Style="{StaticResource GhostButton}" FontSize="9.5"
                                                                            Padding="3,0" Height="16" MinHeight="0" Margin="3,0,0,0"
                                                                            Tag="{Binding}" Click="RetryTransfer_Click"
                                                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                                                    <Button Content="×" Style="{StaticResource GhostButton}" FontSize="12"
                                                                            Padding="3,0" Height="16" MinHeight="0" Width="18"
                                                                            Tag="{Binding}" Click="CancelTransfer_Click" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Height="3" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Monitor -->
                            <ScrollViewer Visibility="{Binding DockIndex, Converter={StaticResource EqualityToVisibility}, ConverterParameter=1}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,9,10,12">
                                    <Grid Margin="2,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="实时状态" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="{Binding SelectedSession.Monitor.LastUpdated}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Content="刷新" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Padding="8,3" Height="25" Click="MonitorRefresh_Click" />
                                    </Grid>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="CPU" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding SelectedSession.Monitor.CpuText}" FontSize="24" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,5" />
                                                <ProgressBar Value="{Binding SelectedSession.Monitor.CpuPercent}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="内存" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding SelectedSession.Monitor.MemoryText}" FontSize="24" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarningBrush}" Margin="0,3,0,3" />
                                                <TextBlock Text="{Binding SelectedSession.Monitor.MemoryDetail}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5" />
                                                <ProgressBar Value="{Binding SelectedSession.Monitor.MemoryPercent}"
                                                             Foreground="{DynamicResource WarningBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="磁盘 /" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding SelectedSession.Monitor.DiskText}" FontSize="24" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,3" />
                                                <TextBlock Text="{Binding SelectedSession.Monitor.DiskDetail}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5" />
                                                <ProgressBar Value="{Binding SelectedSession.Monitor.DiskPercent}"
                                                             Foreground="{DynamicResource SuccessBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="下行" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding SelectedSession.Monitor.NetworkReceive}" FontSize="15"
                                                           FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="上行" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding SelectedSession.Monitor.NetworkSend}" FontSize="15"
                                                           FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource SuccessBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="负载" Style="{StaticResource MutedText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Monitor.LoadText}" FontSize="11" />
                                            <TextBlock Grid.Row="1" Text="运行时间" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSession.Monitor.UptimeText}" FontSize="11" Margin="0,5,0,0" />
                                            <TextBlock Grid.Row="2" Text="主机名" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSession.Monitor.HostName}" FontSize="11" Margin="0,5,0,0" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Padding="10,9"
                                            Visibility="{Binding SelectedSession.Monitor.HasError, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding SelectedSession.Monitor.ErrorMessage}" TextWrapping="Wrap"
                                                   FontSize="10.5" Foreground="{DynamicResource DangerBrush}" />
                                    </Border>

                                    <TextBlock Text="进程占用 Top 10" FontSize="11" FontWeight="SemiBold" Margin="2,4,0,5" />
                                    <Grid Margin="4,0,4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="进程" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="CPU" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="内存" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedSession.Monitor.TopProcesses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Commands -->
                            <Grid Visibility="{Binding DockIndex, Converter={StaticResource EqualityToVisibility}, ConverterParameter=2}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox x:Name="SnippetList" Grid.Row="0" ItemsSource="{Binding Snippets}" Margin="8,8,8,4"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         MouseDoubleClick="SnippetList_MouseDoubleClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Command}" FontFamily="{DynamicResource MonoFont}" FontSize="9.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="235" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE724;" Width="24" Height="24"
                                                                Tag="{Binding}" Click="SendSnippet_Click" ToolTip="发送到当前终端" />
                                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24"
                                                                Tag="{Binding}" Click="DeleteSnippet_Click" ToolTip="删除" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="1" Content="+  新建命令片段" Style="{StaticResource BaseButton}" Margin="10,3,10,9"
                                        Click="AddSnippet_Click" />
                            </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                 Fill="{Binding SelectedSession.Status, Converter={StaticResource SessionStatusToBrush}, TargetNullValue=#8A8F90}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Rectangle Width="1" Height="12" Fill="{DynamicResource BorderBrush}" Margin="10,0" />
                        <TextBlock Text="{Binding SessionCountText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SelectedSession.Monitor.LatencyText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CPU " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SelectedSession.Monitor.CpuText, TargetNullValue=—}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="  ·  内存 " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SelectedSession.Monitor.MemoryText, TargetNullValue=—}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Rectangle Width="1" Height="12" Fill="{DynamicResource BorderBrush}" Margin="10,0" />
                        <TextBlock Text="{Binding MemoryText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ThemeDisplayName}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
